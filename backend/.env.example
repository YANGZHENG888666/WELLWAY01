SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: 数据备份(完整 SQL 备份用;在 Supabase Dashboard → Connect 里获取,
# 形如 postgresql://postgres.xxxx:密码@aws-0-xxx.pooler.supabase.com:5432/postgres)
SUPABASE_DB_URL=postgresql://postgres.你的项目名:你的数据库密码@aws-0-你的区域.pooler.supabase.com:5432/postgres

# Optional: SMTP for email binding / password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
